diff --git a/tests/test_radio.py b/tests/test_radio.py
index 4c2b51f..99977be 100644
--- a/tests/test_radio.py
+++ b/tests/test_radio.py
@@ -167,3 +167,34 @@ class CtcssFrequencyTests(unittest.TestCase):
         self.r.get_ctcss()
         self.assertAlmostEqual(self.r.ctcss_tx_hz, 127.3)
         self.assertAlmostEqual(self.r.ctcss_rx_hz, 88.5)
+
+
+class ToneAndTsqlTests(unittest.TestCase):
+    """CI-V 16 42 is TONE, 16 43 is TSQL (they were wired the other way round)."""
+
+    def setUp(self):
+        self.t = MockCIVTransport()
+        self.r = IC7100(self.t)
+
+    def test_tone_on_uses_16_42(self):
+        self.assertTrue(self.r.set_ctcss(tone_on=True))
+        self.assertEqual(self.t.last_frame()[4:7], b'\x16\x42\x01')
+        self.assertTrue(self.r.tone_on and not self.r.tsql_on)
+
+    def test_tsql_on_uses_16_43(self):
+        self.assertTrue(self.r.set_ctcss(tsql_on=True))
+        self.assertEqual(self.t.last_frame()[4:7], b'\x16\x43\x01')
+        self.assertTrue(self.r.tsql_on and not self.r.tone_on)
+
+    def test_get_reads_each_flag_from_its_own_opcode(self):
+        self.t.set_response(0x16, 0x42, b'\x16\x42\x01')   # TONE on
+        self.t.set_response(0x16, 0x43, b'\x16\x43\x00')   # TSQL off
+        self.r.get_ctcss()
+        self.assertEqual((self.r.tone_on, self.r.tsql_on), (True, False))
+
+    def test_old_names_still_work(self):
+        self.r.set_ctcss(tx_on=True)                          # old name for TONE
+        self.assertEqual(self.t.last_frame()[4:6], b'\x16\x42')
+        self.r.set_ctcss(rx_on=True)                          # old name for TSQL
+        self.assertEqual(self.t.last_frame()[4:6], b'\x16\x43')
+        self.assertEqual((self.r.ctcss_tx_on, self.r.ctcss_rx_on), (True, True))
diff --git a/tests/test_server.py b/tests/test_server.py
index b5be938..f4552d9 100644
--- a/tests/test_server.py
+++ b/tests/test_server.py
@@ -93,6 +93,29 @@ class ServerSmokeTests(unittest.TestCase):
         self.assertEqual(atten_frames[0][5], 0x12,
                          "Atten on must send 0x11 0x12, not 0x11 0x20")
 
+    def test_squelch_type_tsql_switches_tsql_not_tone(self):
+        before = self.transport.cmd_count()
+        r = self._post_json('/ic7100cmd', {'cmd': 'squelch_type', 'type': 'tsql'})
+        self.assertTrue(r['ok'])
+        sent = [bytes(f[4:7]) for f in self.transport.sent[before:] if f[4] == 0x16]
+        self.assertIn(b'\x16\x43\x01', sent)          # TSQL on
+        self.assertNotIn(b'\x16\x42\x01', sent)       # not TONE
+        st = self._get_json('/ic7100/status')
+        self.assertTrue(st['tsql_on'])
+        self.assertEqual(st['squelch_type'], 'tsql')
+        self._post_json('/ic7100cmd', {'cmd': 'squelch_type', 'type': 'noise'})
+        self.assertFalse(self._get_json('/ic7100/status')['tsql_on'])
+
+    def test_ctcss_command_accepts_new_and_old_flag_names(self):
+        before = self.transport.cmd_count()
+        self._post_json('/ic7100cmd', {'cmd': 'ctcss', 'tone_on': True})
+        self._post_json('/ic7100cmd', {'cmd': 'ctcss', 'rx_on': True})      # old name for TSQL
+        sent = [bytes(f[4:7]) for f in self.transport.sent[before:] if f[4] == 0x16]
+        self.assertEqual(sent, [b'\x16\x42\x01', b'\x16\x43\x01'])
+        st = self._get_json('/ic7100/status')
+        self.assertEqual((st['tone_on'], st['tsql_on']), (True, True))
+        self.assertEqual((st['ctcss_tx_on'], st['ctcss_rx_on']), (True, True))  # old keys, same flags
+
     def test_post_mode(self):
         r = self._post_json('/ic7100cmd', {'cmd': 'mode', 'mode': 'FM'})
         self.assertTrue(r['ok'])
