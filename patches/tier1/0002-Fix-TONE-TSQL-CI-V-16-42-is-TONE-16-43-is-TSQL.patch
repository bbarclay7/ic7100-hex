From a7d01f0a920840a5bea9f3cd24fb5f7df3df2e82 Mon Sep 17 00:00:00 2001
From: "Brandon Barclay (AK6MJ)" <ak6mj@w7avm.org>
Date: Sat, 3 Oct 2026 19:21:55 -0700
Subject: [PATCH 2/5] Fix TONE/TSQL: CI-V 16 42 is TONE, 16 43 is TSQL

The code treated 16 43 as "TX tone encode" and 16 42 as "RX tone squelch",
which is the wrong way round (Hamlib: S_FUNC_TONE 0x42, S_FUNC_TSQL 0x43).
In the panel the CTCSS card's "on" box therefore switched TSQL on, and
the FM Squelch card's TSQL button switched TONE on.

Checked on an IC-7100: the head unit shows TONE when 16 42 reads 1 and
TSQL when 16 43 reads 1; each switch is also set and read back through
its own opcode. The radio treats the two as exclusive, so turning TSQL
on also turns TONE off.

The flags are now tone_on / tsql_on (radio, status JSON, panel). The old
names stay as aliases, with the meaning their names always implied
(ctcss_tx_on = TONE, ctcss_rx_on = TSQL):
  - IC7100.ctcss_tx_on / ctcss_rx_on (read-only properties)
  - set_ctcss(tx_on=, rx_on=) and the "ctcss" command's tx_on / rx_on
  - ctcss_tx_on / ctcss_rx_on in the status JSON
---
 ic7100ctl/radio.py     | 54 +++++++++++++++++++++++++++++-------------
 ic7100ctl/server.py    | 22 ++++++++++-------
 ic7100ctl/web/panel.js |  4 ++--
 tests/test_radio.py    | 31 ++++++++++++++++++++++++
 tests/test_server.py   | 23 ++++++++++++++++++
 5 files changed, 107 insertions(+), 27 deletions(-)

diff --git a/ic7100ctl/radio.py b/ic7100ctl/radio.py
index d25593d..4fb3da7 100644
--- a/ic7100ctl/radio.py
+++ b/ic7100ctl/radio.py
@@ -201,8 +201,8 @@ class IC7100:
         # Tone-squelch state
         self.ctcss_tx_hz: float = 88.5
         self.ctcss_rx_hz: float = 88.5
-        self.ctcss_tx_on: bool = False
-        self.ctcss_rx_on: bool = False
+        self.tone_on: bool = False      # CI-V 16 42: TONE (repeater tone encode)
+        self.tsql_on: bool = False      # CI-V 16 43: TSQL (tone squelch)
         self.dtcs_on: bool = False
         self.dtcs_code: int = 23
         self.dtcs_polarity: int = 0      # 0..3 — see _DTCS_POLARITY
@@ -415,7 +415,7 @@ class IC7100:
     # -- CTCSS --
 
     def get_ctcss(self):
-        """Read full CTCSS state. Returns (tx_hz, rx_hz, tx_on, rx_on)."""
+        """Read full CTCSS state. Returns (tone_hz, tsql_hz, tone_on, tsql_on)."""
         # The radio answers with three BCD bytes (00 hh ll = tenths of Hz),
         # e.g. 127.3 Hz -> 1B 00 00 12 73.
         r = self._txn(0x1b, subcmd=0x00)            # TX tone freq
@@ -424,19 +424,30 @@ class IC7100:
         r = self._txn(0x1b, subcmd=0x01)            # RX tone squelch freq
         if r and len(r) >= 5 and r[0] == 0x1b and r[1] == 0x01:
             self.ctcss_rx_hz = bcd_to_tone(r[3:5])
-        r = self._txn(0x16, subcmd=0x43)            # TX tone encode enable
-        if r and len(r) >= 3 and r[0] == 0x16 and r[1] == 0x43:
-            self.ctcss_tx_on = bool(r[2])
-        r = self._txn(0x16, subcmd=0x42)            # RX tone squelch enable
+        r = self._txn(0x16, subcmd=0x42)            # TONE (repeater tone) on/off
         if r and len(r) >= 3 and r[0] == 0x16 and r[1] == 0x42:
-            self.ctcss_rx_on = bool(r[2])
+            self.tone_on = bool(r[2])
+        r = self._txn(0x16, subcmd=0x43)            # TSQL (tone squelch) on/off
+        if r and len(r) >= 3 and r[0] == 0x16 and r[1] == 0x43:
+            self.tsql_on = bool(r[2])
         return (self.ctcss_tx_hz, self.ctcss_rx_hz,
-                self.ctcss_tx_on, self.ctcss_rx_on)
+                self.tone_on, self.tsql_on)
 
     def set_ctcss(self, tx_hz: Optional[float] = None,
                   rx_hz: Optional[float] = None,
+                  tone_on: Optional[bool] = None,
+                  tsql_on: Optional[bool] = None,
                   tx_on: Optional[bool] = None,
                   rx_on: Optional[bool] = None) -> bool:
+        """tx_hz = repeater tone (1B 00), rx_hz = tone-squelch tone (1B 01),
+        tone_on = TONE (16 42), tsql_on = TSQL (16 43).
+
+        tx_on / rx_on are the old names for tone_on / tsql_on, kept so
+        existing callers keep working."""
+        if tone_on is None:
+            tone_on = tx_on
+        if tsql_on is None:
+            tsql_on = rx_on
         ok = True
         if tx_hz is not None:
             if self._set_ok(0x1b, subcmd=0x00, data=tone_to_bcd3(tx_hz)):
@@ -448,20 +459,29 @@ class IC7100:
                 self.ctcss_rx_hz = rx_hz
             else:
                 ok = False
-        if tx_on is not None:
-            if self._set_ok(0x16, subcmd=0x43,
-                            data=bytes([0x01 if tx_on else 0x00])):
-                self.ctcss_tx_on = tx_on
+        if tone_on is not None:
+            if self._set_ok(0x16, subcmd=0x42,
+                            data=bytes([0x01 if tone_on else 0x00])):
+                self.tone_on = tone_on
             else:
                 ok = False
-        if rx_on is not None:
-            if self._set_ok(0x16, subcmd=0x42,
-                            data=bytes([0x01 if rx_on else 0x00])):
-                self.ctcss_rx_on = rx_on
+        if tsql_on is not None:
+            if self._set_ok(0x16, subcmd=0x43,
+                            data=bytes([0x01 if tsql_on else 0x00])):
+                self.tsql_on = tsql_on
             else:
                 ok = False
         return ok
 
+    # Old attribute names (the 16 42 / 16 43 meanings were swapped under them).
+    @property
+    def ctcss_tx_on(self) -> bool:
+        return self.tone_on
+
+    @property
+    def ctcss_rx_on(self) -> bool:
+        return self.tsql_on
+
     # -- DTCS --
 
     def set_dtcs_on(self, on: bool) -> bool:
diff --git a/ic7100ctl/server.py b/ic7100ctl/server.py
index 413c278..194f1d5 100644
--- a/ic7100ctl/server.py
+++ b/ic7100ctl/server.py
@@ -279,8 +279,11 @@ class RadioServer:
             # CTCSS / DTCS
             'ctcss_tx_hz':       float(getattr(r, 'ctcss_tx_hz', 0.0) or 0.0),
             'ctcss_rx_hz':       float(getattr(r, 'ctcss_rx_hz', 0.0) or 0.0),
-            'ctcss_tx_on':       bool(getattr(r, 'ctcss_tx_on', False)),
-            'ctcss_rx_on':       bool(getattr(r, 'ctcss_rx_on', False)),
+            'tone_on':           bool(getattr(r, 'tone_on', False)),   # CI-V 16 42
+            'tsql_on':           bool(getattr(r, 'tsql_on', False)),   # CI-V 16 43
+            # Old names for the same two flags, kept for existing clients.
+            'ctcss_tx_on':       bool(getattr(r, 'tone_on', False)),
+            'ctcss_rx_on':       bool(getattr(r, 'tsql_on', False)),
             'dtcs_on':           bool(getattr(r, 'dtcs_on', False)),
             'dtcs_code':         int(getattr(r, 'dtcs_code', 23) or 23),
             'dtcs_polarity':     int(getattr(r, 'dtcs_polarity', 0) or 0),
@@ -313,7 +316,7 @@ class RadioServer:
             'tx_port':           None,
             'rx_boost_pct':      100,
             'squelch_type':      ('dtcs' if getattr(r, 'dtcs_on', False)
-                                  else ('tsql' if getattr(r, 'ctcss_rx_on', False)
+                                  else ('tsql' if getattr(r, 'tsql_on', False)
                                         else 'noise')),
             # Pack a derived settings sub-dict too — handy for clients that
             # want one blob to persist to disk.
@@ -577,11 +580,14 @@ def _cmd_atten(r, p):
 
 
 def _cmd_ctcss(r, p):
-    # Combined-fields panel command — set any/all of tx_hz/rx_hz/tx_on/rx_on.
+    # Combined-fields panel command — set any/all of tx_hz (repeater tone),
+    # rx_hz (tone-squelch tone), tone_on (TONE), tsql_on (TSQL). tx_on and
+    # rx_on are accepted as the old names for tone_on / tsql_on.
     if 'hz' in p and 'tx_hz' not in p:
         p['tx_hz'] = p['hz']  # tolerate spec wording
     ok = r.set_ctcss(tx_hz=p.get('tx_hz'), rx_hz=p.get('rx_hz'),
-                     tx_on=p.get('tx_on'), rx_on=p.get('rx_on'))
+                     tone_on=p.get('tone_on', p.get('tx_on')),
+                     tsql_on=p.get('tsql_on', p.get('rx_on')))
     return _ok() if ok else _fail('set_ctcss NG')
 
 
@@ -630,15 +636,15 @@ def _cmd_raw(r, p):
 def _cmd_squelch_type(r, p):
     t = (p.get('type') or '').lower()
     if t == 'noise':
-        r.set_ctcss(rx_on=False)
+        r.set_ctcss(tsql_on=False)
         r.set_dtcs_on(False)
         return _ok({'squelch_type': 'noise'})
     if t == 'tsql':
         r.set_dtcs_on(False)
-        r.set_ctcss(rx_on=True)
+        r.set_ctcss(tsql_on=True)
         return _ok({'squelch_type': 'tsql'})
     if t == 'dtcs':
-        r.set_ctcss(rx_on=False)
+        r.set_ctcss(tsql_on=False)
         r.set_dtcs_on(True)
         return _ok({'squelch_type': 'dtcs'})
     return _fail('squelch_type: type must be noise|tsql|dtcs')
