From d8cbbfab37613c6fdda90894f0195bd18286e513 Mon Sep 17 00:00:00 2001
From: "Brandon Barclay (AK6MJ)" <ak6mj@w7avm.org>
Date: Sat, 3 Oct 2026 19:22:27 -0700
Subject: [PATCH 3/4] Show Po/SWR/ALC only while transmitting

Po, SWR and ALC are read only while keyed, so after unkeying the status
kept reporting the last transmit's values (the panel's bars stayed stuck),
and the next key-up briefly showed them again before fresh readings
arrived.

IC7100._set_transmitting() now zeroes the three whenever the TX state
changes (from set_ptt() or from get_ptt() noticing a hand-mic key-up), and
the status JSON reports them as 0 unless the radio is transmitting.

Seen on an IC-7100: Po stayed at 227 after a transmit; after this change
it reads 0 in receive and every transmit starts from zero.
---
 ic7100ctl/radio.py   | 12 ++++++++++--
 ic7100ctl/server.py  | 12 +++++++++---
 tests/test_radio.py  | 19 +++++++++++++++++++
 tests/test_server.py |  7 +++++++
 4 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/ic7100ctl/radio.py b/ic7100ctl/radio.py
index 4fb3da7..0a5015f 100644
--- a/ic7100ctl/radio.py
+++ b/ic7100ctl/radio.py
@@ -356,7 +356,7 @@ class IC7100:
         ok = self._set_ok(0x1c, subcmd=0x00,
                           data=bytes([0x01 if on else 0x00]))
         if ok:
-            self.transmitting = on
+            self._set_transmitting(on)
         if not on and self._we_set_data_mode:
             self.set_data_mode(False)
             if self.split and self.swap_vfo():
@@ -365,10 +365,18 @@ class IC7100:
             self._we_set_data_mode = False
         return ok
 
+    def _set_transmitting(self, on: bool) -> None:
+        """Record the TX state. Po/SWR/ALC are only read while transmitting, so
+        they keep their last value in between; wipe them whenever the state
+        flips so a new key-up never starts by showing the previous transmit."""
+        if bool(on) != self.transmitting:
+            self.po = self.swr = self.alc = 0
+        self.transmitting = bool(on)
+
     def get_ptt(self) -> Optional[bool]:
         resp = self._txn(0x1c, subcmd=0x00)
         if resp and len(resp) >= 3 and resp[0] == 0x1c and resp[1] == 0x00:
-            self.transmitting = bool(resp[2])
+            self._set_transmitting(resp[2])
             return self.transmitting
         return None
 
diff --git a/ic7100ctl/server.py b/ic7100ctl/server.py
index 194f1d5..ae97d7b 100644
--- a/ic7100ctl/server.py
+++ b/ic7100ctl/server.py
@@ -273,9 +273,11 @@ class RadioServer:
             'ptt_active':        bool(getattr(r, 'transmitting', False)),
             'smeter':            int(getattr(r, 'smeter', 0) or 0),
             'squelch_open':      bool(getattr(r, 'squelch_open', True)),
-            'po':                int(getattr(r, 'po', 0) or 0),
-            'swr':               int(getattr(r, 'swr', 0) or 0),
-            'alc':               int(getattr(r, 'alc', 0) or 0),
+            # TX-only meters: they aren't read while receiving, so without this
+            # the last transmit's value would sit on screen indefinitely.
+            'po':                _tx_only(r, 'po'),
+            'swr':               _tx_only(r, 'swr'),
+            'alc':               _tx_only(r, 'alc'),
             # CTCSS / DTCS
             'ctcss_tx_hz':       float(getattr(r, 'ctcss_tx_hz', 0.0) or 0.0),
             'ctcss_rx_hz':       float(getattr(r, 'ctcss_rx_hz', 0.0) or 0.0),
@@ -435,6 +437,10 @@ def _cmd_filter(r, p):
     return _ok({'filter': int(idx)}) if ok else _fail('set_filter NG')
 
 
+def _tx_only(r, attr: str) -> int:
+    return int(getattr(r, attr, 0) or 0) if getattr(r, 'transmitting', False) else 0
+
+
 def _cmd_ptt(r, p):
     if 'state' in p:
         on = bool(p['state'])
diff --git a/tests/test_radio.py b/tests/test_radio.py
index 99977be..a399a02 100644
--- a/tests/test_radio.py
+++ b/tests/test_radio.py
@@ -198,3 +198,22 @@ class ToneAndTsqlTests(unittest.TestCase):
         self.r.set_ctcss(rx_on=True)                          # old name for TSQL
         self.assertEqual(self.t.last_frame()[4:6], b'\x16\x43')
         self.assertEqual((self.r.ctcss_tx_on, self.r.ctcss_rx_on), (True, True))
+
+
+class StaleTxMeterTests(unittest.TestCase):
+    def test_tx_meters_are_wiped_when_the_transmit_state_flips(self):
+        t = MockCIVTransport(); r = IC7100(t)
+        r.set_ptt(True)
+        r.po, r.alc, r.swr = 68, 134, 5            # readings during transmit 1
+        r.set_ptt(False)
+        self.assertEqual((r.po, r.alc, r.swr), (0, 0, 0))
+        r.po = 99                                   # stray value while receiving
+        r.set_ptt(True)                             # transmit 2 must start from zero
+        self.assertEqual(r.po, 0)
+
+    def test_get_ptt_seeing_the_end_of_a_transmit_also_wipes(self):
+        t = MockCIVTransport(); r = IC7100(t)
+        r.transmitting = True; r.po = 80
+        t.set_response(0x1c, 0x00, b'\x1c\x00\x00')   # radio says: not transmitting
+        r.get_ptt()
+        self.assertEqual((r.transmitting, r.po), (False, 0))
diff --git a/tests/test_server.py b/tests/test_server.py
index f4552d9..041588d 100644
--- a/tests/test_server.py
+++ b/tests/test_server.py
@@ -116,6 +116,13 @@ class ServerSmokeTests(unittest.TestCase):
         self.assertEqual((st['tone_on'], st['tsql_on']), (True, True))
         self.assertEqual((st['ctcss_tx_on'], st['ctcss_rx_on']), (True, True))  # old keys, same flags
 
+    def test_tx_meters_read_zero_when_not_transmitting(self):
+        self.radio.po, self.radio.swr, self.radio.alc = 227, 40, 30
+        self.assertFalse(self.radio.transmitting)
+        self.server._refresh_state()                # don't depend on the poll timer
+        st = self._get_json('/ic7100/status')
+        self.assertEqual((st['po'], st['swr'], st['alc']), (0, 0, 0))
+
     def test_post_mode(self):
         r = self._post_json('/ic7100cmd', {'cmd': 'mode', 'mode': 'FM'})
         self.assertTrue(r['ok'])
